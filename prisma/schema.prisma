generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum ShopItemType {
  avatar
  frame
  card_back
  card_face
}

enum CosmeticRenderMode {
  image
  template
}

enum ItemRarity {
  common
  rare
  epic
  legendary
}

enum ShopItemAvailabilityMode {
  always_on
  scheduled
  seasonal
  limited
  event_only
}

enum InventorySource {
  purchase
  grant
  migration
}

enum PurchaseStatus {
  completed
  reverted
}

enum PromotionTargetType {
  global
  shop_item
  bundle
}

enum PromotionDiscountType {
  percentage
  fixed_coin
}

enum ModerationActionType {
  suspend
  reactivate
  note
}

enum WalletAdjustmentType {
  credit
  debit
}

enum WalletLedgerSource {
  legacy_balance_snapshot
  account_opening
  match_reward
  store_item_purchase
  store_bundle_purchase
  coin_grant
  admin_adjustment
  payment_topup
}

enum CoinGrantClaimStatus {
  completed
}

enum SupportTicketStatus {
  open
  in_progress
  resolved
  closed
}

enum SupportTicketPriority {
  low
  normal
  high
}

enum SupportTicketCategory {
  account
  gameplay
  store
  rewards
  bug
  report
  other
}

enum NotificationType {
  system
  support_reply
  support_status
  economy
  moderation
}

enum MobileAuthTokenKind {
  access
  refresh
}

enum UserAccountStatus {
  active
  pending_email_verification
}

enum EmailMessageClass {
  transactional
  marketing
}

enum EmailOutboxStatus {
  pending
  processing
  sent
  dead_letter
}

enum EmailSuppressionReason {
  hard_bounce
  complaint
  manual
}

enum EmailSuppressionScope {
  all
  marketing
}

enum EmailDeliveryEventType {
  delivered
  hard_bounce
  complaint
}
enum PaymentProvider {
  shopier_v2
  iyzico
  paytr
  stripe
  lemonsqueezy
}

enum PaymentOrderStatus {
  created
  pending_provider
  awaiting_payment
  paid
  fulfilled
  failed
  expired
  refunded
  chargeback
}

enum PaymentProductKind {
  cosmetic_item
  cosmetic_bundle
  coin_pack
}

enum PaymentAttemptStatus {
  created
  requested
  succeeded
  failed
}

enum PaymentFulfillmentStatus {
  pending
  completed
  failed
  reversed
}

enum PaymentWebhookProcessingStatus {
  pending
  processing
  retry
  processed
  dead_letter
}

enum PaymentWebhookOutcome {
  payment_succeeded
  payment_failed
  refund
  chargeback
  ignored
}

model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique @db.VarChar(50)
  email     String?  @db.VarChar(191)
  normalizedEmail String? @unique @map("normalized_email") @db.VarChar(191)
  emailVerifiedAt DateTime? @map("email_verified_at")
  emailVerificationRequiredAt DateTime? @map("email_verification_required_at")
  pendingEmail String? @map("pending_email") @db.VarChar(191)
  pendingNormalizedEmail String? @unique @map("pending_normalized_email") @db.VarChar(191)
  pendingEmailRequestedAt DateTime? @map("pending_email_requested_at")
  accountStatus UserAccountStatus @default(active) @map("account_status")
  password  String?  @db.VarChar(255)
  sessionVersion Int @default(0) @map("session_version")
  role      String   @default("user") @db.VarChar(20)
  isSuspended Boolean @default(false) @map("is_suspended")
  suspendedAt DateTime? @map("suspended_at")
  suspendedUntil DateTime? @map("suspended_until")
  suspensionReason String? @map("suspension_reason") @db.VarChar(300)
  lastSeenAt DateTime? @map("last_seen_at")
  lastTrustedIp String? @map("last_trusted_ip") @db.VarChar(64)
  lastUserAgent String? @map("last_user_agent") @db.VarChar(255)
  registeredTrustedIp String? @map("registered_trusted_ip") @db.VarChar(64)
  createdAt DateTime @default(now()) @map("created_at")

  profile      UserProfile?
  wallet       Wallet?
  inventory    InventoryItem[]
  purchases    Purchase[]
  matchResults MatchResult[]
  guestLinks   GuestProgress[]
  auditLogs    AuditLog[]   @relation("AuditActor")
  systemSettingsUpdated SystemSetting[] @relation("SystemSettingUpdatedBy")
  moderationActionsAuthored UserModerationEvent[] @relation("ModerationActor")
  moderationActionsReceived UserModerationEvent[] @relation("ModerationTarget")
  walletAdjustmentsAuthored WalletAdjustment[] @relation("WalletAdjustmentActor")
  walletAdjustmentsReceived WalletAdjustment[] @relation("WalletAdjustmentTarget")
  walletLedgerEntriesAuthored WalletLedgerEntry[] @relation("WalletLedgerActor")
  coinGrantClaims          CoinGrantClaim[]
  coinGrantCampaignUsage   CoinGrantCampaignUser[]
  supportTicketsOwned      SupportTicket[]        @relation("SupportTicketOwner")
  supportTicketsAssigned   SupportTicket[]        @relation("SupportTicketAssignee")
  supportMessagesAuthored  SupportTicketMessage[] @relation("SupportMessageAuthor")
  notifications            Notification[]
  mobileAuthSessions       MobileAuthSession[]
  emailVerificationTokens  EmailVerificationToken[]
  passwordResetTokens      PasswordResetToken[]
  emailChangeTokens        EmailChangeToken[]
  emailOutboxMessages      EmailOutboxMessage[]
  emailSuppressions        EmailSuppression[]
  oauthAccounts            OAuthAccount[]
  paymentOrders            PaymentOrder[]

  @@index([emailVerifiedAt])
  @@index([accountStatus, emailVerificationRequiredAt])
  @@index([isSuspended, suspendedUntil])
  @@index([lastSeenAt])
  @@map("users")
}

model PaymentOffer {
  id                 Int                @id @default(autoincrement())
  code               String             @unique @db.VarChar(80)
  productKind        PaymentProductKind @map("product_kind")
  productReference   String             @map("product_reference") @db.VarChar(120)
  productVersion     Int                @map("product_version")
  productName        String             @map("product_name") @db.VarChar(160)
  description        String?            @db.VarChar(500)
  unitAmountMinor    Int                @map("unit_amount_minor")
  currency           String             @db.Char(3)
  grantSnapshot      Json               @map("grant_snapshot") @db.Json
  isActive           Boolean            @default(false) @map("is_active")
  sortOrder          Int                @default(0) @map("sort_order")
  startsAt           DateTime?           @map("starts_at")
  endsAt             DateTime?           @map("ends_at")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")

  @@index([isActive, sortOrder])
  @@index([startsAt, endsAt])
  @@map("payment_offers")
}

model PaymentOrder {
  id                       String             @id @default(uuid()) @db.Char(36)
  userId                   Int                @map("user_id")
  provider                 PaymentProvider
  providerConfigVersion    Int                @default(1) @map("provider_config_version")
  status                   PaymentOrderStatus @default(created)
  idempotencyKey           String             @map("idempotency_key") @db.VarChar(128)
  requestFingerprint       String             @map("request_fingerprint") @db.Char(64)
  productKind              PaymentProductKind @map("product_kind")
  productReference         String             @map("product_reference") @db.VarChar(120)
  productVersion           Int                @map("product_version")
  productNameSnapshot      String             @map("product_name_snapshot") @db.VarChar(160)
  quantity                 Int                @default(1)
  unitAmountMinor          Int                @map("unit_amount_minor")
  totalAmountMinor         Int                @map("total_amount_minor")
  currency                 String             @db.Char(3)
  grantSnapshot            Json               @map("grant_snapshot") @db.Json
  providerOrderReference   String?            @map("provider_order_reference") @db.VarChar(191)
  providerSessionReference String?            @map("provider_session_reference") @db.VarChar(191)
  version                  Int                @default(1)
  expiresAt                DateTime?          @map("expires_at")
  paidAt                   DateTime?          @map("paid_at")
  fulfilledAt              DateTime?          @map("fulfilled_at")
  failedAt                 DateTime?          @map("failed_at")
  refundedAt               DateTime?          @map("refunded_at")
  chargebackAt             DateTime?          @map("chargeback_at")
  createdAt                DateTime           @default(now()) @map("created_at")
  updatedAt                DateTime           @updatedAt @map("updated_at")

  user        User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  attempts    PaymentAttempt[]
  fulfillment PaymentFulfillment?
  webhookEvents PaymentWebhookEvent[]
  checkoutConsent PaymentCheckoutConsent?

  @@unique([userId, idempotencyKey])
  @@unique([provider, providerOrderReference])
  @@unique([provider, providerSessionReference])
  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([provider, status, createdAt])
  @@map("payment_orders")
}

model PaymentCheckoutConsent {
  id                           String   @id @default(uuid()) @db.Char(36)
  orderId                      String   @unique @map("order_id") @db.Char(36)
  checkoutTermsVersion         String   @map("checkout_terms_version") @db.VarChar(80)
  privacyNoticeVersion         String   @map("privacy_notice_version") @db.VarChar(80)
  distanceSalesNoticeVersion   String   @map("distance_sales_notice_version") @db.VarChar(80)
  acceptedAt                   DateTime @map("accepted_at")
  requestId                    String?  @map("request_id") @db.VarChar(80)
  userAgentHash                String?  @map("user_agent_hash") @db.Char(64)
  createdAt                    DateTime @default(now()) @map("created_at")

  order PaymentOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([acceptedAt])
  @@map("payment_checkout_consents")
}

model PaymentAttempt {
  id                 String               @id @default(uuid()) @db.Char(36)
  orderId            String               @map("order_id") @db.Char(36)
  attemptNumber      Int                  @map("attempt_number")
  status             PaymentAttemptStatus @default(created)
  requestFingerprint String               @map("request_fingerprint") @db.Char(64)
  providerRequestId  String?              @map("provider_request_id") @db.VarChar(191)
  errorCode          String?              @map("error_code") @db.VarChar(80)
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")

  order PaymentOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, attemptNumber])
  @@unique([orderId, providerRequestId])
  @@index([status, createdAt])
  @@map("payment_attempts")
}

model PaymentFulfillment {
  id             String                   @id @default(uuid()) @db.Char(36)
  orderId        String                   @unique @map("order_id") @db.Char(36)
  status         PaymentFulfillmentStatus @default(pending)
  fulfillmentKey String                   @unique @map("fulfillment_key") @db.VarChar(191)
  attemptCount   Int                      @default(0) @map("attempt_count")
  grantResult    Json?                    @map("grant_result") @db.Json
  errorCode      String?                  @map("error_code") @db.VarChar(80)
  completedAt    DateTime?                @map("completed_at")
  reversedAt     DateTime?                @map("reversed_at")
  createdAt      DateTime                 @default(now()) @map("created_at")
  updatedAt      DateTime                 @updatedAt @map("updated_at")

  order PaymentOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([status, createdAt])
  @@map("payment_fulfillments")
}

model PaymentWebhookEvent {
  id                       String                          @id @default(uuid()) @db.Char(36)
  provider                 PaymentProvider
  providerEventId          String                          @map("provider_event_id") @db.VarChar(191)
  eventType                String                          @map("event_type") @db.VarChar(120)
  outcome                  PaymentWebhookOutcome
  bodySha256               String                          @map("body_sha256") @db.Char(64)
  signatureVersion         String?                         @map("signature_version") @db.VarChar(32)
  orderId                  String?                         @map("order_id") @db.Char(36)
  providerOrderReference   String?                         @map("provider_order_reference") @db.VarChar(191)
  providerPaymentReference String?                         @map("provider_payment_reference") @db.VarChar(191)
  amountMinor              Int?                            @map("amount_minor")
  currency                 String?                         @db.Char(3)
  metadata                 Json?                           @db.Json
  status                   PaymentWebhookProcessingStatus @default(pending)
  deliveryCount            Int                             @default(1) @map("delivery_count")
  attemptCount             Int                             @default(0) @map("attempt_count")
  availableAt              DateTime                        @default(now()) @map("available_at")
  claimToken               String?                         @map("claim_token") @db.Char(36)
  claimedAt                DateTime?                       @map("claimed_at")
  claimExpiresAt           DateTime?                       @map("claim_expires_at")
  lastReceivedAt           DateTime                        @default(now()) @map("last_received_at")
  lastAttemptAt            DateTime?                       @map("last_attempt_at")
  processedAt              DateTime?                       @map("processed_at")
  lastErrorCode            String?                         @map("last_error_code") @db.VarChar(80)
  occurredAt               DateTime?                       @map("occurred_at")
  createdAt                DateTime                        @default(now()) @map("created_at")
  updatedAt                DateTime                        @updatedAt @map("updated_at")

  order PaymentOrder? @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@unique([provider, providerEventId])
  @@index([status, availableAt, createdAt])
  @@index([status, claimExpiresAt])
  @@index([provider, providerOrderReference])
  @@index([orderId, createdAt])
  @@map("payment_webhook_events")
}

model OAuthAccount {
  id                String   @id @default(uuid()) @db.Char(36)
  userId            Int      @map("user_id")
  type              String   @db.VarChar(16)
  provider          String   @db.VarChar(32)
  providerAccountId String   @map("provider_account_id") @db.VarChar(191)
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@unique([userId, provider])
  @@index([userId, createdAt])
  @@map("oauth_accounts")
}

model MobileAuthSession {
  id               String    @id @default(uuid()) @db.Char(36)
  userId           Int       @map("user_id")
  deviceName       String    @map("device_name") @db.VarChar(80)
  userAgent        String?   @map("user_agent") @db.VarChar(255)
  createdAt        DateTime  @default(now()) @map("created_at")
  lastSeenAt       DateTime  @default(now()) @map("last_seen_at")
  refreshExpiresAt DateTime  @map("refresh_expires_at")
  revokedAt        DateTime? @map("revoked_at")
  revokeReason     String?   @map("revoke_reason") @db.VarChar(64)

  user   User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokens MobileAuthToken[]

  @@index([userId, revokedAt, lastSeenAt])
  @@index([refreshExpiresAt])
  @@map("mobile_auth_sessions")
}

model MobileAuthToken {
  id              String              @id @default(uuid()) @db.Char(36)
  sessionId       String              @map("session_id") @db.Char(36)
  kind            MobileAuthTokenKind
  tokenHash       String              @unique @map("token_hash") @db.Char(64)
  expiresAt       DateTime            @map("expires_at")
  consumedAt      DateTime?           @map("consumed_at")
  revokedAt       DateTime?           @map("revoked_at")
  rotationCounter Int                 @default(0) @map("rotation_counter")
  createdAt       DateTime            @default(now()) @map("created_at")

  session MobileAuthSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, kind, revokedAt, expiresAt])
  @@index([expiresAt])
  @@map("mobile_auth_tokens")
}

model EmailVerificationToken {
  id            String    @id @db.Char(36)
  userId        Int       @map("user_id")
  tokenHash     String    @unique @map("token_hash") @db.Char(64)
  emailSnapshot String    @map("email_snapshot") @db.VarChar(191)
  expiresAt     DateTime  @map("expires_at")
  consumedAt    DateTime? @map("consumed_at")
  revokedAt     DateTime? @map("revoked_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, consumedAt, revokedAt, expiresAt])
  @@index([expiresAt])
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id         String    @id @db.Char(36)
  userId     Int       @map("user_id")
  tokenHash  String    @unique @map("token_hash") @db.Char(64)
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, consumedAt, revokedAt, expiresAt])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model EmailChangeToken {
  id                      String    @id @db.Char(36)
  userId                  Int       @map("user_id")
  tokenHash               String    @unique @map("token_hash") @db.Char(64)
  emailSnapshot           String    @map("email_snapshot") @db.VarChar(191)
  normalizedEmailSnapshot String    @map("normalized_email_snapshot") @db.VarChar(191)
  expiresAt               DateTime  @map("expires_at")
  consumedAt              DateTime? @map("consumed_at")
  revokedAt               DateTime? @map("revoked_at")
  createdAt               DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, consumedAt, revokedAt, expiresAt])
  @@index([normalizedEmailSnapshot, expiresAt])
  @@index([expiresAt])
  @@map("email_change_tokens")
}

model EmailOutboxMessage {
  id               String            @id @db.Char(36)
  userId           Int?              @map("user_id")
  deduplicationKey String            @unique @map("deduplication_key") @db.VarChar(191)
  messageClass     EmailMessageClass @map("message_class")
  template         String            @db.VarChar(80)
  recipient        String            @db.VarChar(191)
  subject          String            @db.VarChar(191)
  payload          Json              @db.Json
  status           EmailOutboxStatus @default(pending)
  attemptCount     Int               @default(0) @map("attempt_count")
  manualRetryCount Int               @default(0) @map("manual_retry_count")
  availableAt      DateTime          @default(now()) @map("available_at")
  lastAttemptAt    DateTime?         @map("last_attempt_at")
  sentAt           DateTime?         @map("sent_at")
  lastError        String?           @map("last_error") @db.VarChar(255)
  claimToken       String?           @map("claim_token") @db.Char(36)
  claimedAt        DateTime?         @map("claimed_at")
  claimExpiresAt   DateTime?         @map("claim_expires_at")
  lastManualRetryAt DateTime?        @map("last_manual_retry_at")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status, availableAt, createdAt])
  @@index([userId, createdAt])
  @@index([messageClass, status, createdAt])
  @@index([status, claimExpiresAt])
  @@map("email_outbox_messages")
}

model EmailSuppression {
  id              String                 @id @default(uuid()) @db.Char(36)
  userId          Int?                   @map("user_id")
  normalizedEmail String                 @unique @map("normalized_email") @db.VarChar(191)
  reason          EmailSuppressionReason
  scope           EmailSuppressionScope  @default(all)
  source          String                 @db.VarChar(40)
  note            String?                @db.VarChar(255)
  createdAt       DateTime               @default(now()) @map("created_at")
  updatedAt       DateTime               @updatedAt @map("updated_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([reason, createdAt])
  @@index([userId, createdAt])
  @@map("email_suppressions")
}

model EmailDeliveryEvent {
  id                String                 @id @default(uuid()) @db.Char(36)
  provider          String                 @db.VarChar(40)
  providerEventId   String                 @map("provider_event_id") @db.VarChar(191)
  eventType         EmailDeliveryEventType @map("event_type")
  normalizedEmail   String                 @map("normalized_email") @db.VarChar(191)
  providerMessageId String?                @map("provider_message_id") @db.VarChar(191)
  occurredAt        DateTime               @map("occurred_at")
  createdAt         DateTime               @default(now()) @map("created_at")

  @@unique([provider, providerEventId])
  @@index([normalizedEmail, occurredAt])
  @@index([eventType, occurredAt])
  @@map("email_delivery_events")
}

model UserModerationEvent {
  id             Int                  @id @default(autoincrement())
  targetUserId   Int                  @map("target_user_id")
  actorUserId    Int?                 @map("actor_user_id")
  actionType     ModerationActionType @map("action_type")
  reason         String               @db.VarChar(500)
  suspendedUntil DateTime?            @map("suspended_until")
  createdAt      DateTime             @default(now()) @map("created_at")

  targetUser User  @relation("ModerationTarget", fields: [targetUserId], references: [id], onDelete: Cascade)
  actorUser  User? @relation("ModerationActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([targetUserId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([actionType, createdAt])
  @@map("user_moderation_events")
}

model AuditLog {
  id          Int      @id @default(autoincrement())
  actorUserId Int?     @map("actor_user_id")
  actorRole   String   @map("actor_role") @db.VarChar(20)
  action      String   @db.VarChar(80)
  resourceType String  @map("resource_type") @db.VarChar(80)
  resourceId  String?  @map("resource_id") @db.VarChar(120)
  ipAddress   String?  @map("ip_address") @db.VarChar(64)
  userAgent   String?  @map("user_agent") @db.VarChar(255)
  summary     String?  @db.VarChar(255)
  metadata    Json?    @db.Json
  createdAt   DateTime @default(now()) @map("created_at")

  actor User? @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
  @@index([resourceType, createdAt])
  @@index([resourceType, resourceId])
  @@map("audit_logs")
}

model AuditLogArchive {
  id                 Int      @id @default(autoincrement())
  originalAuditLogId Int      @unique @map("original_audit_log_id")
  actorUserId        Int?     @map("actor_user_id")
  actorUsername      String?  @map("actor_username") @db.VarChar(50)
  actorRole          String   @map("actor_role") @db.VarChar(20)
  action             String   @db.VarChar(80)
  resourceType       String   @map("resource_type") @db.VarChar(80)
  resourceId         String?  @map("resource_id") @db.VarChar(120)
  ipAddress          String?  @map("ip_address") @db.VarChar(64)
  userAgent          String?  @map("user_agent") @db.VarChar(255)
  summary            String?  @db.VarChar(255)
  metadata           Json?    @db.Json
  originalCreatedAt  DateTime @map("original_created_at")
  archivedAt         DateTime @default(now()) @map("archived_at")

  @@index([actorUserId, originalCreatedAt])
  @@index([actorRole, originalCreatedAt])
  @@index([action, originalCreatedAt])
  @@index([resourceType, originalCreatedAt])
  @@index([resourceType, resourceId])
  @@index([archivedAt])
  @@map("audit_log_archives")
}

model SystemSetting {
  key             String   @id @db.VarChar(80)
  value           Json     @db.Json
  updatedByUserId Int?     @map("updated_by_user_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  updatedBy User? @relation("SystemSettingUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@index([updatedByUserId])
  @@map("system_settings")
}

model UserProfile {
  id             Int      @id @default(autoincrement())
  userId         Int      @unique @map("user_id")
  displayName    String?  @map("display_name") @db.VarChar(60)
  bio            String?  @db.VarChar(300)
  avatarItemId   Int?     @map("avatar_item_id")
  frameItemId    Int?     @map("frame_item_id")
  cardBackItemId Int?     @map("card_back_item_id")
  cardFaceItemId Int?     @map("card_face_item_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  avatarItem   ShopItem? @relation("ProfileAvatar", fields: [avatarItemId], references: [id], onDelete: SetNull)
  frameItem    ShopItem? @relation("ProfileFrame", fields: [frameItemId], references: [id], onDelete: SetNull)
  cardBackItem ShopItem? @relation("ProfileCardBack", fields: [cardBackItemId], references: [id], onDelete: SetNull)
  cardFaceItem ShopItem? @relation("ProfileCardFace", fields: [cardFaceItemId], references: [id], onDelete: SetNull)

  @@map("user_profiles")
}

model Wallet {
  id          Int      @id @default(autoincrement())
  userId      Int      @unique @map("user_id")
  coinBalance Int      @default(0) @map("coin_balance")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  ledgerEntries WalletLedgerEntry[]

  @@map("wallets")
}

model WalletLedgerEntry {
  id             Int                @id @default(autoincrement())
  walletId       Int                @map("wallet_id")
  source         WalletLedgerSource
  deltaCoin      Int                @map("delta_coin")
  balanceBefore  Int                @map("balance_before")
  balanceAfter   Int                @map("balance_after")
  idempotencyKey String             @unique @map("idempotency_key") @db.VarChar(191)
  referenceType  String?            @map("reference_type") @db.VarChar(80)
  referenceId    String?            @map("reference_id") @db.VarChar(120)
  actorUserId    Int?               @map("actor_user_id")
  metadata       Json?              @db.Json
  createdAt      DateTime           @default(now()) @map("created_at")

  wallet      Wallet             @relation(fields: [walletId], references: [id], onDelete: Cascade)
  actorUser   User?              @relation("WalletLedgerActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  adjustment  WalletAdjustment?

  @@index([walletId, createdAt])
  @@index([source, createdAt])
  @@index([referenceType, referenceId])
  @@index([actorUserId, createdAt])
  @@map("wallet_ledger_entries")
}

model WalletAdjustment {
  id            Int                  @id @default(autoincrement())
  targetUserId  Int                  @map("target_user_id")
  actorUserId   Int?                 @map("actor_user_id")
  adjustmentType WalletAdjustmentType @map("adjustment_type")
  amount        Int
  reason        String               @db.VarChar(500)
  balanceBefore Int                  @map("balance_before")
  balanceAfter  Int                  @map("balance_after")
  ledgerEntryId Int?                 @unique @map("ledger_entry_id")
  createdAt     DateTime             @default(now()) @map("created_at")

  targetUser User  @relation("WalletAdjustmentTarget", fields: [targetUserId], references: [id], onDelete: Cascade)
  actorUser  User? @relation("WalletAdjustmentActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  ledgerEntry WalletLedgerEntry? @relation(fields: [ledgerEntryId], references: [id], onDelete: Restrict)

  @@index([targetUserId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([adjustmentType, createdAt])
  @@map("wallet_adjustments")
}

model CoinGrantCampaign {
  id                Int       @id @default(autoincrement())
  code              String    @unique @db.VarChar(80)
  name              String    @db.VarChar(120)
  description       String?   @db.VarChar(300)
  coinAmount        Int       @map("coin_amount")
  totalBudgetCoin   Int?      @map("total_budget_coin")
  totalGrantedCoin  Int       @default(0) @map("total_granted_coin")
  totalClaimLimit   Int?      @map("total_claim_limit")
  totalClaimCount   Int       @default(0) @map("total_claim_count")
  perUserClaimLimit Int       @default(1) @map("per_user_claim_limit")
  startsAt          DateTime? @map("starts_at")
  endsAt            DateTime? @map("ends_at")
  isActive          Boolean   @default(true) @map("is_active")
  archivedAt        DateTime? @map("archived_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  codes      CoinGrantCode[]
  claims     CoinGrantClaim[]
  userClaims CoinGrantCampaignUser[]

  @@index([isActive, archivedAt, startsAt, endsAt])
  @@map("coin_grant_campaigns")
}

model CoinGrantCode {
  id         Int       @id @default(autoincrement())
  campaignId Int       @map("campaign_id")
  code       String    @unique @db.VarChar(80)
  label      String?   @db.VarChar(120)
  maxClaims  Int?      @map("max_claims")
  claimCount Int       @default(0) @map("claim_count")
  expiresAt  DateTime? @map("expires_at")
  isActive   Boolean   @default(true) @map("is_active")
  archivedAt DateTime? @map("archived_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  campaign CoinGrantCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  claims   CoinGrantClaim[]

  @@index([campaignId, isActive, archivedAt])
  @@map("coin_grant_codes")
}

model CoinGrantCampaignUser {
  campaignId  Int      @map("campaign_id")
  userId      Int      @map("user_id")
  claimCount  Int      @default(0) @map("claim_count")
  grantedCoin Int      @default(0) @map("granted_coin")
  lastClaimAt DateTime @default(now()) @map("last_claim_at")

  campaign CoinGrantCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([campaignId, userId])
  @@index([userId, lastClaimAt])
  @@map("coin_grant_campaign_users")
}

model CoinGrantClaim {
  id         Int                  @id @default(autoincrement())
  campaignId Int                  @map("campaign_id")
  codeId     Int                  @map("code_id")
  userId     Int                  @map("user_id")
  status     CoinGrantClaimStatus @default(completed)
  coinAmount Int                  @map("coin_amount")
  createdAt  DateTime             @default(now()) @map("created_at")

  campaign CoinGrantCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  code     CoinGrantCode     @relation(fields: [codeId], references: [id], onDelete: Restrict)
  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([campaignId, createdAt])
  @@index([codeId, createdAt])
  @@index([userId, createdAt])
  @@map("coin_grant_claims")
}

model SupportTicket {
  id                  Int                   @id @default(autoincrement())
  userId              Int                   @map("user_id")
  assignedAdminUserId Int?                  @map("assigned_admin_user_id")
  category            SupportTicketCategory
  priority            SupportTicketPriority @default(normal)
  status              SupportTicketStatus   @default(open)
  subject             String                @db.VarChar(160)
  lastMessageAt       DateTime              @default(now()) @map("last_message_at")
  lastPublicReplyAt   DateTime?             @map("last_public_reply_at")
  closedAt            DateTime?             @map("closed_at")
  createdAt           DateTime              @default(now()) @map("created_at")
  updatedAt           DateTime              @updatedAt @map("updated_at")

  user          User                 @relation("SupportTicketOwner", fields: [userId], references: [id], onDelete: Cascade)
  assignedAdmin User?                @relation("SupportTicketAssignee", fields: [assignedAdminUserId], references: [id], onDelete: SetNull)
  messages      SupportTicketMessage[]

  @@index([userId, status, updatedAt])
  @@index([assignedAdminUserId, status, updatedAt])
  @@index([status, priority, lastMessageAt])
  @@map("support_tickets")
}

model SupportTicketMessage {
  id           Int      @id @default(autoincrement())
  ticketId     Int      @map("ticket_id")
  authorUserId Int?     @map("author_user_id")
  isInternal   Boolean  @default(false) @map("is_internal")
  body         String   @db.Text
  createdAt    DateTime @default(now()) @map("created_at")

  ticket  SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author  User?         @relation("SupportMessageAuthor", fields: [authorUserId], references: [id], onDelete: SetNull)

  @@index([ticketId, createdAt])
  @@index([authorUserId, createdAt])
  @@map("support_ticket_messages")
}

model Notification {
  id          Int              @id @default(autoincrement())
  userId      Int              @map("user_id")
  type        NotificationType
  title       String           @db.VarChar(160)
  body        String           @db.VarChar(500)
  resourceType String?         @map("resource_type") @db.VarChar(80)
  resourceId  String?          @map("resource_id") @db.VarChar(120)
  actionLabel String?          @map("action_label") @db.VarChar(40)
  actionHref  String?          @map("action_href") @db.VarChar(255)
  isRead      Boolean          @default(false) @map("is_read")
  readAt      DateTime?        @map("read_at")
  archivedAt  DateTime?        @map("archived_at")
  metadata    Json?            @db.Json
  createdAt   DateTime         @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, archivedAt, createdAt])
  @@index([userId, type, createdAt])
  @@index([resourceType, resourceId])
  @@map("notifications")
}

model ShopItem {
  id        Int          @id @default(autoincrement())
  code      String       @unique @db.VarChar(80)
  type      ShopItemType
  name      String       @db.VarChar(120)
  rarity    ItemRarity   @default(common)
  renderMode CosmeticRenderMode @default(image) @map("render_mode")
  renderSpecVersion Int  @default(1) @map("render_spec_version")
  priceCoin Int          @map("price_coin")
  imageUrl  String       @map("image_url") @db.Text
  thumbnailUrl String?   @map("thumbnail_url") @db.Text
  templateKey String?    @map("template_key") @db.VarChar(80)
  templateConfig Json?   @map("template_config")
  badgeText String?      @map("badge_text") @db.VarChar(24)
  availabilityMode ShopItemAvailabilityMode @default(always_on) @map("availability_mode")
  startsAt  DateTime?    @map("starts_at")
  endsAt    DateTime?    @map("ends_at")
  isFeatured Boolean     @default(false) @map("is_featured")
  isActive  Boolean      @default(true) @map("is_active")
  sortOrder Int          @default(0) @map("sort_order")
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  inventoryItems     InventoryItem[]
  purchases          Purchase[]
  bundleEntries      ShopBundleItem[]
  discountCampaigns  DiscountCampaign[]
  couponCodes        CouponCode[]
  equippedByAvatar   UserProfile[] @relation("ProfileAvatar")
  equippedByFrame    UserProfile[] @relation("ProfileFrame")
  equippedByCardBack UserProfile[] @relation("ProfileCardBack")
  equippedByCardFace UserProfile[] @relation("ProfileCardFace")

  @@map("shop_items")
  @@index([isActive, availabilityMode, startsAt, endsAt, sortOrder])
}

model ShopBundle {
  id          Int      @id @default(autoincrement())
  code        String   @unique @db.VarChar(80)
  name        String   @db.VarChar(120)
  description String?  @db.VarChar(300)
  priceCoin   Int      @map("price_coin")
  isActive    Boolean  @default(true) @map("is_active")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  items             ShopBundleItem[]
  discountCampaigns DiscountCampaign[]
  couponCodes       CouponCode[]
  purchases         Purchase[]

  @@map("shop_bundles")
}

model ShopBundleItem {
  id         Int      @id @default(autoincrement())
  bundleId   Int      @map("bundle_id")
  shopItemId Int      @map("shop_item_id")
  sortOrder  Int      @default(0) @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at")

  bundle   ShopBundle @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  shopItem ShopItem   @relation(fields: [shopItemId], references: [id], onDelete: Cascade)

  @@unique([bundleId, shopItemId])
  @@index([bundleId, sortOrder])
  @@map("shop_bundle_items")
}

model DiscountCampaign {
  id               Int                   @id @default(autoincrement())
  code             String                @unique @db.VarChar(80)
  name             String                @db.VarChar(120)
  description      String?               @db.VarChar(300)
  targetType       PromotionTargetType   @default(global) @map("target_type")
  discountType     PromotionDiscountType @map("discount_type")
  percentageOff    Int?                  @map("percentage_off")
  fixedCoinOff     Int?                  @map("fixed_coin_off")
  shopItemId       Int?                  @map("shop_item_id")
  bundleId         Int?                  @map("bundle_id")
  usageLimit       Int?                  @map("usage_limit")
  usedCount        Int                   @default(0) @map("used_count")
  startsAt         DateTime?             @map("starts_at")
  endsAt           DateTime?             @map("ends_at")
  isActive         Boolean               @default(true) @map("is_active")
  stackableWithCoupon Boolean            @default(false) @map("stackable_with_coupon")
  createdAt        DateTime              @default(now()) @map("created_at")
  updatedAt        DateTime              @updatedAt @map("updated_at")

  shopItem ShopItem?   @relation(fields: [shopItemId], references: [id], onDelete: SetNull)
  bundle   ShopBundle? @relation(fields: [bundleId], references: [id], onDelete: SetNull)

  @@index([targetType, isActive])
  @@map("discount_campaigns")
}

model CouponCode {
  id               Int                   @id @default(autoincrement())
  code             String                @unique @db.VarChar(80)
  name             String                @db.VarChar(120)
  description      String?               @db.VarChar(300)
  targetType       PromotionTargetType   @default(global) @map("target_type")
  discountType     PromotionDiscountType @map("discount_type")
  percentageOff    Int?                  @map("percentage_off")
  fixedCoinOff     Int?                  @map("fixed_coin_off")
  shopItemId       Int?                  @map("shop_item_id")
  bundleId         Int?                  @map("bundle_id")
  usageLimit       Int?                  @map("usage_limit")
  usedCount        Int                   @default(0) @map("used_count")
  startsAt         DateTime?             @map("starts_at")
  endsAt           DateTime?             @map("ends_at")
  isActive         Boolean               @default(true) @map("is_active")
  createdAt        DateTime              @default(now()) @map("created_at")
  updatedAt        DateTime              @updatedAt @map("updated_at")

  shopItem ShopItem?   @relation(fields: [shopItemId], references: [id], onDelete: SetNull)
  bundle   ShopBundle? @relation(fields: [bundleId], references: [id], onDelete: SetNull)
  purchases Purchase[]

  @@index([targetType, isActive])
  @@map("coupon_codes")
}

model InventoryItem {
  id         Int             @id @default(autoincrement())
  userId     Int             @map("user_id")
  shopItemId Int             @map("shop_item_id")
  source     InventorySource @default(purchase)
  renderSnapshot Json?       @map("render_snapshot") @db.Json
  acquiredAt DateTime        @default(now()) @map("acquired_at")

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  shopItem ShopItem @relation(fields: [shopItemId], references: [id], onDelete: Cascade)

  @@unique([userId, shopItemId])
  @@index([userId])
  @@map("inventory_items")
}

model Purchase {
  id           Int            @id @default(autoincrement())
  userId       Int            @map("user_id")
  shopItemId   Int?           @map("shop_item_id")
  bundleId     Int?           @map("bundle_id")
  couponCodeId Int?           @map("coupon_code_id")
  priceCoin    Int            @map("price_coin")
  listPriceCoin Int?          @map("list_price_coin")
  discountCoin Int            @default(0) @map("discount_coin")
  status       PurchaseStatus @default(completed)
  createdAt    DateTime       @default(now()) @map("created_at")

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  shopItem   ShopItem?  @relation(fields: [shopItemId], references: [id], onDelete: Restrict)
  bundle     ShopBundle? @relation(fields: [bundleId], references: [id], onDelete: SetNull)
  couponCode CouponCode? @relation(fields: [couponCodeId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([bundleId])
  @@index([couponCodeId])
  @@map("purchases")
}

model MatchResult {
  id                       Int      @id @default(autoincrement())
  roomCode                 String   @map("room_code") @db.VarChar(12)
  matchStartedAt           DateTime @default(now()) @map("match_started_at")
  matchEndedAt             DateTime? @map("match_ended_at")
  matchDurationSeconds     Int?     @map("match_duration_seconds")
  matchFormat              String?  @map("match_format") @db.VarChar(20)
  matchTarget              Int?     @map("match_target")
  gameType                 String   @default("tabu") @map("game_type") @db.VarChar(30)
  userId                   Int      @map("user_id")
  playerId                 String   @map("player_id") @db.VarChar(64)
  team                     String?  @db.VarChar(1)
  won                      Boolean
  scoreA                   Int      @map("score_a")
  scoreB                   Int      @map("score_b")
  coinEarned               Int      @default(0) @map("coin_earned")
  lineupKey                String?  @map("lineup_key") @db.VarChar(96)
  lineupPlayerCount        Int      @default(0) @map("lineup_player_count")
  lineupAuthenticatedCount Int      @default(0) @map("lineup_authenticated_count")
  lineupGuestCount         Int      @default(0) @map("lineup_guest_count")
  createdAt                DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomCode, userId, matchStartedAt])
  @@index([userId, createdAt])
  @@index([userId, lineupKey, createdAt])
  @@map("match_results")
}

model GuestProgress {
  id                 Int      @id @default(autoincrement())
