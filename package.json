    "test:product-analytics": "tsx scripts/test-product-analytics.ts",
    "test:word-analytics": "tsx scripts/test-word-analytics-liveops.ts",
    "test:release-ops-docs": "tsx scripts/test-release-ops-docs.ts",
    "test:admin-dashboard-cache": "tsx scripts/test-admin-dashboard-cache.ts",
    "typecheck:packages": "tsc -p packages/domain-game/tsconfig.json && tsc -p packages/platform-cache/tsconfig.json && tsc -p packages/platform-db/tsconfig.json && tsc -p apps/jobs/tsconfig.json",
    "test:package-boundaries": "tsx scripts/test-package-boundaries.ts",
    "test:domain-game": "tsx scripts/test-domain-game.ts",
    "test:jobs-runtime": "tsx scripts/test-jobs-runtime.ts",
    "test:jobs-runtime-integration": "tsx scripts/test-jobs-runtime-integration.ts",
