    "test:room-capacity-socket": "tsx scripts/test-room-capacity-socket-integration.ts",
    "test:room-capacity-load": "tsx scripts/test-room-capacity-load.ts",
    "test:room-registered-start-rule": "tsx scripts/test-room-registered-start-rule.ts",
    "test:room-admission-closed": "tsx scripts/test-room-admission-closed.ts",
    "test:late-spectator-reward": "tsx scripts/test-late-spectator-reward.ts",
    "test:distributed-coordination": "tsx scripts/test-distributed-coordination.ts",
    "test:system-settings": "tsx scripts/test-system-settings.ts",
    "test:captcha-security": "tsx scripts/test-captcha-security.ts",
    "test:turnstile-smoke": "tsx scripts/test-turnstile-smoke.ts",
    "test:economy-liveops": "tsx scripts/test-economy-liveops.ts",
    "test:economy-guardrails": "tsx scripts/test-economy-guardrails.ts",
    "test:economy-guardrails-edge": "tsx scripts/test-economy-guardrails-edge.ts",
    "test:user-email-foundation": "tsx scripts/test-user-email-foundation.ts",
    "test:admin-user-operations": "tsx scripts/test-admin-user-operations.ts",
    "test:admin-audit-viewer": "tsx scripts/test-admin-audit-viewer.ts",
    "test:admin-audit-archive": "tsx scripts/test-admin-audit-archive.ts",
    "test:admin-match-history": "tsx scripts/test-admin-match-history.ts",
    "test:coin-grant-campaigns": "tsx scripts/test-coin-grant-campaigns.ts",
    "test:support-desk-foundation": "tsx scripts/test-support-desk-foundation.ts",
    "test:system-notifications": "tsx scripts/test-system-notifications.ts",
    "test:auth-redirect-security": "tsx scripts/test-auth-redirect-security.ts",
    "test:promotion-field-references": "tsx scripts/test-promotion-field-references.ts",
    "test:admin-table-foundation": "tsx scripts/test-admin-table-foundation.ts",
    "test:moderation-foundation": "tsx scripts/test-moderation-foundation.ts",
    "test:admin-access-gateway": "tsx scripts/test-admin-access-gateway.ts",
