    "test:store-pricing": "tsx scripts/test-store-pricing.ts",
    "test:announcement-security": "tsx scripts/test-announcement-security.ts",
    "test:announcement-structure": "tsx scripts/test-announcement-structure.ts",
    "test:admin-guards": "tsx scripts/test-admin-route-guards.ts",
    "test:card-face": "tsx scripts/test-card-face-theme.ts",
    "test:card-back": "tsx scripts/test-card-back-theme.ts",
