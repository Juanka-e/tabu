{
  "name": "newnextjs",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "predev": "npm run db:generate",
    "dev": "npm run dev --workspace @hushle/web",
    "predev:next": "npm run db:generate",
    "dev:next": "npm run dev:next --workspace @hushle/web",
    "prebuild": "npm run db:generate",
    "build": "npm run build --workspace @hushle/web",
    "start": "npm run start --workspace @hushle/web",
    "jobs:run": "tsx apps/jobs/src/runner.ts",
    "jobs:audit-retention": "npm run jobs:run -- audit-retention dry-run",
    "pretypecheck:web": "npm run db:generate",
    "typecheck:web": "npm run typecheck --workspace @hushle/web",
    "infra:up": "docker compose -f docker-compose.dev.yml up -d",
    "infra:down": "docker compose -f docker-compose.dev.yml down",
    "infra:logs": "docker compose -f docker-compose.dev.yml logs -f",
    "infra:status": "docker compose -f docker-compose.dev.yml ps",
    "test:offsite-backups": "bash scripts/test-offsite-backups.sh",
    "test:offsite-backups-integration": "bash scripts/test-offsite-backups-integration.sh --run",
    "test:redis": "tsx scripts/test-redis-connection.ts",
    "test:json-cache": "tsx scripts/test-json-cache-foundation.ts",
    "test:application-cache": "tsx scripts/test-application-cache-integration.ts",
    "test:store-catalog-cache": "tsx scripts/test-store-catalog-cache.ts",
    "test:notification-cache": "tsx scripts/test-notification-unread-cache.ts",
    "test:user-dashboard-cache": "tsx scripts/test-user-dashboard-cache.ts",
    "test:socket-redis-adapter": "tsx scripts/test-socket-redis-adapter.ts",
    "test:room-ownership": "tsx scripts/test-room-ownership.ts",
    "test:room-ownership-redis": "tsx scripts/test-room-ownership-redis-integration.ts",
    "test:room-routing": "tsx scripts/test-room-routing.ts",
    "test:realtime-topology": "tsx scripts/test-realtime-topology.ts",
