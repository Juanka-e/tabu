NODE_ENV=production
HOST=0.0.0.0
PORT=3000

NEXTAUTH_URL=https://hushle.com
NEXT_PUBLIC_SITE_URL=https://hushle.com
AUTH_SECRET=replace_with_long_random_secret
AUTH_TRUST_HOST=true
TRUST_PROXY=true
HEALTHCHECK_TOKEN=replace_with_long_random_health_token

MYSQL_DATABASE=hushle
MYSQL_USER=hushle
MYSQL_PASSWORD=replace_with_mysql_app_password
MYSQL_ROOT_PASSWORD=replace_with_mysql_root_password
DATABASE_URL=mysql://hushle:replace_with_mysql_app_password@mysql:3306/hushle
DATABASE_CONNECTION_LIMIT=20

REDIS_URL=redis://redis:6379
REDIS_KEY_PREFIX=hushle:production
REDIS_CONNECT_TIMEOUT_MS=3000
REDIS_RETRY_COOLDOWN_MS=30000

# One-shot jobs remain disabled until explicitly invoked in execute mode.
JOBS_ENABLED=false
JOBS_DATABASE_CONNECTION_LIMIT=3
AUDIT_HOT_RETENTION_DAYS=90
AUDIT_ARCHIVE_BATCH_SIZE=500
AUDIT_ARCHIVE_MAX_BATCHES=10
AUDIT_ARCHIVE_LEASE_TTL_MS=900000
